  {
   "cell_type": "markdown",
   "id": "4f4340b9",
   "metadata": {},
   "source": [
    "#### 4. Integration by harmony"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2c7a1bf1",
   "metadata": {},
   "outputs": [],
   "source": [
    "BALL_C12.Obj <- readRDS(\"/PATH/BALL_JointAssay_K_4_Mye_C12_55Samples_AddFragments_DownSample.rds\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a4ec4f33",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RNA\n",
    "DefaultAssay(BALL_C12.Obj) <- \"RNA\"\n",
    "BALL_C12.Obj <- NormalizeData(BALL_C12.Obj)\n",
    "BALL_C12.Obj <- FindVariableFeatures(BALL_C12.Obj, selection.method = \"vst\", nfeatures = 3000)\n",
    "BALL_C12.Obj <- ScaleData(BALL_C12.Obj)\n",
    "BALL_C12.Obj <- RunPCA(BALL_C12.Obj)\n",
    "# harmony\n",
    "BALL_C12.Obj <- RunHarmony(object = BALL_C12.Obj, group.by.vars = 'Patient.Sample', reduction.use = 'pca', assay.use = 'RNA', project.dim = F, reduction.save = \"rna.pca.harmony\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f2307150",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ATAC\n",
    "# Normalization and linear dimensional reduction\n",
    "DefaultAssay(BALL_C12.Obj) <- \"ATAC\"\n",
    "BALL_C12.Obj <- FindTopFeatures(BALL_C12.Obj, min.cutoff = 'q90')\n",
    "BALL_C12.Obj <- RunTFIDF(BALL_C12.Obj)\n",
    "BALL_C12.Obj <- RunSVD(BALL_C12.Obj)\n",
    "# harmony\n",
    "BALL_C12.Obj <- RunHarmony(object = BALL_C12.Obj, group.by.vars = 'Patient.Sample', reduction.use = 'lsi', assay.use = 'ATAC', project.dim = F, reduction.save = \"atac.lsi.harmony\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "961e8a17",
   "metadata": {},
   "outputs": [],
   "source": [
    "# build a joint neighbor graph using both assays\n",
    "BALL_C12.Obj <- FindMultiModalNeighbors(\n",
    "    object = BALL_C12.Obj,\n",
    "    reduction.list = list(\"rna.pca.harmony\", \"atac.lsi.harmony\"), \n",
    "    dims.list = list(1:30, 2:30),\n",
    "    modality.weight.name = c(\"rna.pca.harmony.weight\", \"atac.lsi.harmony.weight\"),\n",
    "    verbose = TRUE\n",
    "  )\n",
    "  \n",
    "# build a joint UMAP visualization\n",
    "BALL_C12.Obj <- RunUMAP(\n",
    "    object = BALL_C12.Obj,\n",
    "    nn.name = \"weighted.nn\",\n",
    "    reduction.name = \"harmony.wnn.umap\",\n",
    "    verbose = TRUE\n",
    "  )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e23c1753",
   "metadata": {},
   "outputs": [],
   "source": [
    "saveRDS(BALL_C12.Obj, \"/PATH/BALL_Blast_C12_55Samples_DownSample_Harmony_WNN.rds\")"
   ]
