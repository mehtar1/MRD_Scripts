   "source": [
    "# subset blast cell\n",
    "table(BALL.Object_1@meta.data$Level1.anno)\n",
    "BALL.Object_1 <- subset(BALL.Object_1, Level1.anno == \"Blast\")\n",
    "\n",
    "table(BALL.Object_2@meta.data$Level1.anno)\n",
    "BALL.Object_2 <- subset(BALL.Object_2, Level1.anno == \"Blast\")"
